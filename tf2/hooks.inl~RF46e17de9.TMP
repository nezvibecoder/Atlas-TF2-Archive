void ATLAS_THISCALL hkSetColorModulation( CStudioRender *thisptr, const float *color )
{
    if ( !g_cl.m_is_running || !g_world_modulation.m_drawing_static_props )
    {
        return g_hooks.m_set_color_modulation.thiscall< void >( thisptr, color );
    }

    float modulated[ 3 ]{ };
    g_world_modulation.modulate_static_prop( color, modulated );

    return g_hooks.m_set_color_modulation.thiscall< void >( thisptr, modulated );
}

void ATLAS_THISCALL hkDrawStaticProps(
    IStaticPropMgr     *thisptr,
    IClientRenderable **props,
    i32                 count,
    bool                shadow_depth,
    bool                draw_vcollide_wireframe )
{
