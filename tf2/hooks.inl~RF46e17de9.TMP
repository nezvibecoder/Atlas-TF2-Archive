void ATLAS_THISCALL hkMatchInviteOnTick( void *thisptr )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_match_invite_on_tick.thiscall< void >( thisptr );
    }

    if ( g_cfg.m_queue.m_delay_join )
    {
        f64      &deadline{ *reinterpret_cast< f64 * >( reinterpret_cast< uptr >( thisptr ) + 0x268 ) };
        const f64 now{ g_tf2.m_engine->Plat_FloatTime( ) };

        if ( deadline != 0.0 && deadline < now + 11.0 )
        {
            deadline = now + g_cfg.m_queue.m_delay_join_time;
        }
    }

    g_hooks.m_match_invite_on_tick.thiscall< void >( thisptr );
}

void ATLAS_THISCALL hkEmitSound( void *thisptr, void *filter, i32 entity_index, const EmitSound_t *params )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_emit_sound.thiscall< void >( thisptr, filter, entity_index, params );
    }

    if ( params && ( g_skins.mutes_sound( entity_index, params->m_pSoundName ) ||
                     g_misc.mutes_footstep( params->m_pSoundName ) ) )
    {
        return;
    }

    g_hooks.m_emit_sound.thiscall< void >( thisptr, filter, entity_index, params );
}

// this is where the client picks gibs over a ragdoll and builds the corpse
// from its flags, and they are rewritten right before it
void ATLAS_THISCALL hkRagdollOnDataChanged( IClientNetworkable *thisptr, DataUpdateType_t type )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_ragdoll_on_data_changed.thiscall< void >( thisptr, type );
    }

    if ( type == DATA_UPDATE_CREATED )
    {
        if ( C_BaseEntity * entity{ thisptr->GetIClientUnknown( )->GetBaseEntity( ) } )
        {
            g_skins.on_ragdoll_created( entity->As< C_TFRagdoll * >( ) );
        }
    }

    g_hooks.m_ragdoll_on_data_changed.thiscall< void >( thisptr, type );
}

class store_restore_ragdoll_vars
{
public:
    store_restore_ragdoll_vars( )
    {
        m_old_fade_time      = g_tf2.cl_ragdoll_fade_time->GetFloat( );
        m_old_force_fade     = g_tf2.cl_ragdoll_forcefade->GetInt( );
        m_old_physics_enable = g_tf2.cl_ragdoll_physics_enable->GetInt( );
    }

    ~store_restore_ragdoll_vars( )
    {
        g_tf2.cl_ragdoll_fade_time->SetValue( m_old_fade_time );
        g_tf2.cl_ragdoll_forcefade->SetValue( m_old_force_fade );
        g_tf2.cl_ragdoll_physics_enable->SetValue( m_old_physics_enable );
    }

private:
    f32 m_old_fade_time{ };
    i32 m_old_force_fade{ };
    i32 m_old_physics_enable{ };
};

void ATLAS_THISCALL hkCreateTFRagdoll( C_TFRagdoll *thisptr )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_create_tf_ragdoll.thiscall< void >( thisptr );
    }

    if ( !g_skins.on_ragdoll_created( thisptr ) )
    {
        return g_hooks.m_create_tf_ragdoll.thiscall< void >( thisptr );
    }

    {
        store_restore_ragdoll_vars scope{ };
        g_tf2.cl_ragdoll_fade_time->SetValue( 30.f );
        g_tf2.cl_ragdoll_forcefade->SetValue( 0 );
        g_tf2.cl_ragdoll_physics_enable->SetValue( 1 );

        g_hooks.m_create_tf_ragdoll.thiscall< void >( thisptr );
    }
}

