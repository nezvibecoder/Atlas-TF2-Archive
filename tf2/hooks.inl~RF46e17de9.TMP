void ATLAS_THISCALL hkPaint( CEngineVGui *thisptr, i32 mode )
{
    if ( !g_cl.m_is_running || g_cl.should_perform_clean_frame( ) )
    {
        return g_hooks.m_paint.thiscall< void >( thisptr, mode );
    }

    g_hooks.m_paint.thiscall< void >( thisptr, mode );

    if ( mode & PAINT_UIPANELS )
    {
        g_cl.update_w2s( );
        g_esp.render_target( );
        g_ragebot.render( );
        g_proj_sim.render( );
        g_auto_rocketjmp.render( );
        g_esp.paint( );
        g_anti_aim.paint( );
#if defined( ATLAS_DEV )
        g_server_hitboxes.paint( );
#endif // ATLAS_DEV
        g_hitmarker.paint( );
        g_fall_damage.paint( );
        g_esp_builder.paint( );
        g_trajectory.paint( );
        g_projectile_warning.paint( );
        g_lagcomp.paint( );
        g_tracers.paint( );
        g_extrapolate.paint( );
        g_ragebot.paint( );
        g_recorder.paint( );
        g_script_api.paint( );
        g_radio.on_frame( );
        g_soundboard.on_frame( );
        g_draw.send( );
    }
}

