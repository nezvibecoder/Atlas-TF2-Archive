    {
        return g_hooks.m_do_image_space_motion_blur.thiscall< void >( setup, x, y, width, height );
    }

    if ( g_cfg.m_misc.m_removals[ config::REMOVAL_MOTION_BLUR ] == true )
    {
        return;
    }

    // note: we could also use this to increase motion blur value, something that moneybot had..

    g_hooks.m_do_image_space_motion_blur.thiscall< void >( setup, x, y, width, height );
}

