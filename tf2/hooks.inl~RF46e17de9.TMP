// NOTE: Hoku;
// This fixes a major flaw in Valve's ConVar fetching routine.
// In CCVar::FindCommand, CConCommandHash::FindPtr is called.
// The iteration is slow for multiple reasons:
// 1. Pointers are needlessly compared.
// 2. The hashing algo that Valve uses is not efficient in a runtime context.
// 3. The name of the ConCommand/ConVar is not hashed at all if the command is being searched for by name.
// We solve this by caching every ConVar when we walk the linked list in entry, and just returning the
// cached pointer from the command table we built. unordered_map hashing is MAJORLY faster and will improve engine performance
// significantly.
const ConCommandBase *ATLAS_THISCALL hkFindCommandBase_const( ICvar *thisptr, const char *name )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_find_command_const.thiscall< ConCommandBase * >( thisptr, name );
    }

    auto cvar{ g_tf2.m_cmd_table.get( HASH_RT( name ) ) };
    if ( !cvar )
    {
        const auto fallback{ g_hooks.m_find_command_const.thiscall< ConCommandBase * >( thisptr, name ) };
        if ( fallback )
        {
            cvar = g_tf2.m_cmd_table.insert( HASH_RT( fallback->m_pszName ), fallback );
        } else
        {
            return nullptr;
        }
    }

    return cvar ? *cvar : nullptr;
}

ConCommandBase *ATLAS_THISCALL hkFindCommandBase( ICvar *thisptr, const char *name )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_find_command.thiscall< ConCommandBase * >( thisptr, name );
    }

    auto cvar{ g_tf2.m_cmd_table.get( HASH_RT( name ) ) };
    if ( !cvar )
    {
        const auto fallback{ g_hooks.m_find_command_const.thiscall< ConCommandBase * >( thisptr, name ) };
        if ( fallback )
        {
            cvar = g_tf2.m_cmd_table.insert( HASH_RT( fallback->m_pszName ), fallback );
        } else
        {
            return nullptr;
        }
    }

    return cvar ? *cvar : nullptr;
}

void ATLAS_THISCALL hkUnregisterConCommand( ICvar *thisptr, ConCommandBase *variable )
{
    g_hooks.m_unregister_con_command.thiscall< void >( thisptr, variable );
    const auto cached{ g_tf2.m_cmd_table.get( HASH_RT( variable->m_pszName ) ) };
    if ( cached && *cached == variable )
    {
        g_tf2.m_cmd_table.erase( HASH_RT( variable->m_pszName ) );
    }
}

void ATLAS_THISCALL hkUnregisterConCommands( ICvar *thisptr, i32 dll_identifier )
{
    g_hooks.m_unregister_con_commands.thiscall< void >( thisptr, dll_identifier );
    g_tf2.m_cmd_table.clear( );
}

bool ATLAS_THISCALL hkInCond( CTFPlayerShared *thisptr, ETFCond cond )
{
    if ( !g_cl.m_is_running || !g_cl.m_local || g_cl.should_perform_clean_frame( ) )
    {
        return g_hooks.m_in_cond.thiscall< bool >( thisptr, cond );
    }

    // Let the game do what it naturally does when dead.
    if ( !g_cl.m_local->IsAlive( ) )
    {
        return g_hooks.m_in_cond.thiscall< bool >( thisptr, cond );
    }

    const auto shared{ g_cl.m_local->GetSharedPlayerData( ) };
    if ( !shared )
    {
        return g_hooks.m_in_cond.thiscall< bool >( thisptr, cond );
    }

    const auto retaddr = ( uptr )__builtin_return_address( 0 );
    const bool is_local{ shared == thisptr };

    switch ( cond )
    {
        case TF_COND_DISGUISED:
        case TF_COND_DISGUISED_AS_DISPENSER: // Condition bit 42 kept here for funny servers that decide to re-enable it's functionality. (Game logic still runs on it!)
        {
            if ( !is_local && g_cfg.m_misc.m_removals[ config::REMOVAL_DISGUISES ] == true )
            {
                return false;
            }

            const bool picks_model{ retaddr == g_tf2.m_C_TFPlayer_ValidateModelIndex_dispenser_retaddr.get_raw( ) ||
                                    retaddr == g_tf2.m_C_TFPlayer_ValidateModelIndex_disguise_retaddr.get_raw( ) };
            if ( !is_local && picks_model && g_cfg.m_ragebot.m_enabled && !g_cfg.m_ragebot.m_ignores[ config::IGNORE_DISGUISED ] )
            {
                return false;
            }

            break;
        }

        case TF_COND_TAUNTING:
        {
            if ( !is_local && g_cfg.m_misc.m_removals[ config::REMOVAL_TAUNTS ] == true )
            {
                return false;
            }

            // Allow us to freely move while taunting.
            // We still keep the movement speed and gun restrictions unfortunately (it was patched a long time ago).
            // But, funny conga sideways.
            if ( retaddr == g_tf2.m_C_TFPlayer_CreateMove_retaddr.get_raw( ) &&
                 ( g_cfg.m_misc.m_removals[ config::REMOVAL_TAUNT_RESTRICTIONS ] == true || g_misc.is_taunt_exploit_taking_place( ) ) )
            {
                return false;
            }

            break;
        }

        case TF_COND_FREEZE_INPUT:
        {
            if ( retaddr == g_tf2.m_C_TFPlayer_CreateMove_freeze_retaddr.get_raw( ) &&
                 g_cfg.m_misc.m_removals[ config::REMOVAL_KART_CAGE ] == true )
            {
                return false;
            }

            break;
        }

        case TF_COND_HALLOWEEN_KART:
        {
            if ( ( retaddr == g_tf2.m_C_TFPlayer_CreateMove_kart_retaddr.get_raw( ) ||
                   retaddr == g_tf2.m_CTFInput_ApplyMouse_kart_retaddr.get_raw( ) ) &&
                 g_cfg.m_misc.m_removals[ config::REMOVAL_KART_RESTRICTIONS ] == true )
            {
                return false;
            }

            break;
        }

        default: break;
    }

    // Some dumb intern at Valve decided it was a good idea to check if the player was ever scoped to prevent the local player model from drawing.
    // Considering the fact that MVM medieval mode has a technically undocumented thirdperson functionality, this was probably made
    // for something in regards to that but was scrapped early on in the game's development. Either way it serves as nothing but
    // a pointless annoyance for us, so we fix it here.
    if ( ( g_cfg.m_misc.m_removals[ config::REMOVAL_SCOPE_OVERLAY ] == true ||
           g_cfg.m_misc.m_removals[ config::REMOVAL_SCOPE_ZOOM ] == true ) &&
         ( retaddr == g_tf2.m_C_TFPlayer_ShouldDraw_retaddr.get_raw( ) ||
           retaddr == g_tf2.m_C_TFWearable_ShouldDraw_retaddr.get_raw( ) ) )
    {
        return false;
    }

    return g_hooks.m_in_cond.thiscall< bool >( thisptr, cond );
}

void ATLAS_THISCALL hkPaintTraverse( vgui::IPanel *thisptr, vgui::VPANEL vguiPanel, bool forceRepaint, bool allowForce )
{
    if ( !g_cl.m_is_running || g_cl.should_perform_clean_frame( ) )
    {
        return g_hooks.m_paint_traverse.thiscall< void >( thisptr, vguiPanel, forceRepaint, allowForce );
    }
    ATLAS_INTEGRITY_CHECK( 0x52B9D4E7A1F608C3ull );

    constexpr static auto hud_scope_panel{ HASH_CT( "HudScope" ) };
    const auto            target_panel{ HASH_RT( thisptr->GetName( vguiPanel ) ) };

    // Prevents the scope overlay panel from drawing if we're scoped.
    // It's annoying.
    if ( target_panel == hud_scope_panel &&
         g_cfg.m_misc.m_removals[ config::REMOVAL_SCOPE_OVERLAY ] == true )
    {
        return;
    }

    if ( !g_streamer_mode.on_paint_traverse( target_panel ) )
    {
        return;
    }

    return g_hooks.m_paint_traverse.thiscall< void >( thisptr, vguiPanel, forceRepaint, allowForce );
}

bool ATLAS_THISCALL hkShouldDrawViewModel( ClientModeShared *thisptr )
{
    if ( !g_cl.m_is_running || !g_cl.m_local || g_cl.should_perform_clean_frame( ) )
    {
        return g_hooks.m_should_draw_view_model.thiscall< bool >( thisptr );
    }

    if ( !g_cl.m_local->IsAlive( ) )
    {
        return g_hooks.m_should_draw_view_model.thiscall< bool >( thisptr );
    }

    if ( g_tf2.m_input->CAM_IsThirdPerson( ) )
    {
        return false;
    }

    if ( ( g_cfg.m_misc.m_removals[ config::REMOVAL_SCOPE_ZOOM ] == true &&
           g_cfg.m_misc.m_removals[ config::REMOVAL_SCOPE_OVERLAY ] == true ) &&
         g_cl.m_local->IsZoomed( ) )
    {
        return g_cfg.m_viewmodel.m_show_in_scope;
    }

    return g_hooks.m_should_draw_view_model.thiscall< bool >( thisptr );
}

void ATLAS_THISCALL hkSetInt( KeyValues *thisptr, const char *keyName, i32 value )
{
    if ( !g_cl.m_is_running || g_cl.should_perform_clean_frame( ) )
    {
        return g_hooks.m_set_int.thiscall< void >( thisptr, keyName, value );
    }

    g_hooks.m_set_int.thiscall< void >( thisptr, keyName, value );

    const auto retaddr = ( uptr )__builtin_return_address( 0 );
    if ( retaddr == g_tf2.m_KeyValues_SetInt_retaddr.get_raw( ) && str::equals( keyName, ATLAS_XORSTR( "nemesis" ).get( ) ) )
    {
        // FIXME: Hoku; For some reason, I wasn't able to get this working while using __builtin_frame_address.
        // I have no idea if __builtin_frame_address is even the same as _AddressOfReturnAddress, however we should figure out
        // a way to swap it out for a builtin so we aren't relying on MSVC intrinsics for this.
        auto frame_addr{ ( uptr * )_AddressOfReturnAddress( ) };
        *frame_addr = g_tf2.m_KeyValues_SetInt_jump.get_raw( );
    }
}

bool ATLAS_THISCALL hkIsPlayerDominated( void *thisptr, i32 idx )
{
    if ( !g_cl.m_is_running || g_cl.should_perform_clean_frame( ) )
    {
        return g_hooks.m_is_player_dominated.thiscall< bool >( thisptr, idx );
    }

    const auto result{ g_hooks.m_is_player_dominated.thiscall< bool >( thisptr, idx ) };
    if ( !result )
    {
        const auto retaddr = ( uptr )__builtin_return_address( 0 );
        if ( retaddr == g_tf2.m_C_TFPlayerShared_IsPlayerDominated_retaddr.get_raw( ) )
        {
            // FIXME: Hoku; For some reason, I wasn't able to get this working while using __builtin_frame_address.
            // I have no idea if __builtin_frame_address is even the same as _AddressOfReturnAddress, however we should figure out
            // a way to swap it out for a builtin so we aren't relying on MSVC intrinsics for this.
            auto frame_addr{ ( uptr * )_AddressOfReturnAddress( ) };
            *frame_addr = g_tf2.m_C_TFPlayerShared_IsPlayerDominated_jump.get_raw( );
        }
    }

    return result;
}

i32 ATLAS_THISCALL hkPlayerPanelGetTeam( void *thisptr )
{
    if ( !g_cl.m_is_running || !g_cl.m_resource || g_cl.should_perform_clean_frame( ) )
    {
        return g_hooks.m_player_panel_get_team.thiscall< i32 >( thisptr );
    }

    const i32 team{ g_hooks.m_player_panel_get_team.thiscall< i32 >( thisptr ) };

    if ( ( uptr )__builtin_return_address( 0 ) != g_tf2.m_TeamStatus_GetTeam_retaddr.get_raw( ) )
    {
        return team;
    }

    return g_cl.m_resource->m_iTeam( )[ g_tf2.m_engine->GetLocalPlayer( ) ];
}

