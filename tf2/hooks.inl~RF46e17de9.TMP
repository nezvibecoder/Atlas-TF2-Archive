{
    g_script_api.shutdown( );
    g_session.shutdown( );
    g_cl.m_is_running = false;
    if ( !g_entity_cache.shutdown( ) )
    {
        DBGOUT( "entity cache: failed to unregister the listener" );
    }
    g_hooks.m_client_shutdown.thiscall< void >( thisptr );
}

