    {
        return g_hooks.m_draw_static_props.thiscall< void >( thisptr, props, count, shadow_depth, draw_vcollide_wireframe );
    }

    g_world_modulation.m_drawing_static_props = true;
    g_hooks.m_draw_static_props.thiscall< void >( thisptr, props, count, shadow_depth, draw_vcollide_wireframe );
    g_world_modulation.m_drawing_static_props = false;
}

void ATLAS_FASTCALL hkFX_FireBullets(
    C_TFWeaponBase *weapon,
    i32             player,
    const vec3     &origin,
    const vec3     &angles,
    i32             weapon_id,
    i32             mode,
    i32             seed,
    float           spread,
    float           damage,
    bool            critical )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_fx_fire_bullets.fastcall< void >( weapon, player, &origin, &angles, weapon_id, mode,
                                                           seed, spread, damage, critical );
    }

    if ( g_nospread.synced( ) && g_tf2.m_prediction->m_bFirstTimePredicted && player == g_tf2.m_engine->GetLocalPlayer( ) )
    {
        seed = g_nospread.seed( ) & 255;
    }

    if ( player != g_tf2.m_engine->GetLocalPlayer( ) )
    {
        g_watchdog.on_fire_bullets( player );
    }

    g_hooks.m_fx_fire_bullets.fastcall< void >( weapon, player, &origin, &angles, weapon_id, mode,
                                                seed, spread, damage, critical );
    if ( g_prediction.m_is_active && weapon == g_cl.m_weapon && player == g_tf2.m_engine->GetLocalPlayer( ) )
    {
        // this shared bullet path calls server ::NoteWeaponFired;
        // ::NoteWeaponFired stores pl.v_angle, which means, bingo!
        vec3 local_angles{ };
        g_hooks.m_get_local_view_angles.thiscall< void >( g_tf2.m_prediction, &local_angles );
        g_holdaim_mgr.lock( local_angles );
    }
}

void ATLAS_FASTCALL hkFireBullet(
    C_TFPlayer              *thisptr,
    C_TFWeaponBase          *weapon,
    const FireBulletsInfo_t &info,
    bool                     do_effects,
    i32                      damage_type,
    i32                      custom_damage_type )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_fire_bullet.thiscall< void >( thisptr, weapon, &info, do_effects, damage_type, custom_damage_type );
    }

    g_tracers.begin_bullet( thisptr, weapon );

    g_hooks.m_fire_bullet.thiscall< void >( thisptr, weapon, &info, do_effects, damage_type, custom_damage_type );

    g_tracers.end_bullet( info );
}

void ATLAS_FASTCALL hkUTIL_ParticleTracer(
    const char *effect,
    const vec3 &start,
    const vec3 &end,
    i32         entity_index,
    i32         attachment,
    bool        whiz )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_util_particle_tracer.fastcall< void >( effect, &start, &end, entity_index,
                                                                attachment, whiz );
    }

    if ( g_tracers.owns_particle( ) )
    {
        return;
    }

    g_hooks.m_util_particle_tracer.fastcall< void >( effect, &start, &end, entity_index, attachment, whiz );
}

bool ATLAS_THISCALL hkDispatchUserMessage( CHLClient *thisptr, i32 msg_type, bf_read &msg_data )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_dispatch_user_message.thiscall< bool >( thisptr, msg_type, &msg_data );
    }

    // TODO: Remove me if this breaks nospread.
    const auto buf_data{ reinterpret_cast< const char * >( msg_data.m_pData ) };
    msg_data.Seek( 0 );

    switch ( msg_type )
    {
        case VoteStart:
        {
            g_event_notifiers.on_dispatch_user_message( msg_data );
            break;
        }

        case TextMsg:
        {
            if ( g_player_perf.on_text_message( msg_data ) )
            {
                return true;
            }

            break;
        }

        case VGUIMenu:
        {
            // Remove the annoying MOTD popups some servers do.
            if ( HASH_RT( buf_data ) == HASH_CT( "info" ) &&
                 g_cfg.m_misc.m_removals[ config::REMOVAL_MOTD ] == true )
            {
                g_tf2.m_engine->ClientCmd_Unrestricted( ATLAS_XORSTR( "closedwelcomemenu" ).get( ) );
                return true;
            }

            break;
        }

        case Shake:
        case Rumble:
        case Fade: return g_cfg.m_misc.m_removals[ config::REMOVAL_OVERLAYS ] == true ? true : g_hooks.m_dispatch_user_message.thiscall< bool >( thisptr, msg_type, &msg_data );

        default: break;
    }

    return g_hooks.m_dispatch_user_message.thiscall< bool >( thisptr, msg_type, &msg_data );
}

bool ATLAS_THISCALL hkFireEventClientSide( IGameEventManager2 *thisptr, IGameEvent *event )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_fire_event_client_side.thiscall< bool >( thisptr, event );
    }

    if ( event )
    {
        if ( HASH_RT( event->GetName( ) ) == HASH_CT( "party_chat" ) && g_party_network.on_party_chat( event ) )
        {
            thisptr->FreeEvent( event );
            return false;
        }

        if ( g_cfg.m_streamer_mode.m_enabled )
        {
            const auto event_name{ HASH_RT( event->GetName( ) ) };
            switch ( event_name )
            {
                case HASH_CT( "player_team" ):
                case HASH_CT( "player_connect" ):
                case HASH_CT( "player_connect_client" ):
                case HASH_CT( "player_disconnect" ):
                {
                    event->SetString( ATLAS_XORSTR( "name" ).get( ), ATLAS_XORSTR( "Player" ).get( ) );
                    break;
                }

                default: break;
            }
        }

        g_skins.on_event( event );
    }

    return g_hooks.m_fire_event_client_side.thiscall< bool >( thisptr, event );
}

i32 ATLAS_THISCALL hkGetModelIndex( CModelInfoClient *thisptr, const char *name )
{
    if ( !g_cl.m_is_running || !name )
    {
        return g_hooks.m_get_model_index.thiscall< i32 >( thisptr, name );
    }

    const i32 index{ g_hooks.m_get_model_index.thiscall< i32 >( thisptr, name ) };

    if ( index != -1 || !name )
    {
        return index;
    }

    return g_skins.index_for_model( name );
}

float ATLAS_THISCALL hkApplyAttributeFloatWrapper( void *thisptr, float value, C_BaseEntity *initiator, const char *hook, void *items )
{
    if ( !g_cl.m_is_running || !initiator || !hook )
    {
        return g_hooks.m_apply_attribute_float_wrapper.thiscall< float >( thisptr, value, initiator, hook, items );
    }

    if ( !items && initiator && hook )
    {
        if ( float answer{ }; g_skins.attribute_hook( initiator, hook, answer ) )
        {
            return answer;
        }
    }

    return g_hooks.m_apply_attribute_float_wrapper.thiscall< float >( thisptr, value, initiator, hook, items );
}

i32 ATLAS_THISCALL hkAttribHookValueInt( i32 value, const char *hook, C_BaseEntity *initiator, void *items, bool global_string )
{
    if ( !g_cl.m_is_running || !hook || !initiator )
    {
        return g_hooks.m_attrib_hook_value_int.thiscall< i32 >( value, hook, initiator, items, global_string );
    }

    if ( !items && initiator && hook )
    {
        if ( float answer{ }; g_skins.attribute_hook( initiator, hook, answer ) )
        {
            return static_cast< i32 >( answer );
        }
    }

    return g_hooks.m_attrib_hook_value_int.thiscall< i32 >( value, hook, initiator, items, global_string );
}

