#pragma once

#include "features/features.hpp"
#include "runtime/integrity.hpp"
#include "script_api.hpp"

i32 ATLAS_STDCALL hkPresent(
    void       *device,
    const void *src_rect,
    const void *dest_rect,
    const void *hwnd_override,
    const void *dirty_region )
{
    if ( !g_session.poll( ) )
    {
        g_input.block( false );
        g_render.set_stream_proof( false );
        return g_hooks.m_present.stdcall< i32 >( device, src_rect, dest_rect, hwnd_override, dirty_region );
    }

    g_skybox.service( );
    g_skins.service_game_tables( );

    if ( !g_cl.m_is_early_init_finished )
    {
        return g_hooks.m_present.stdcall< i32 >( device, src_rect, dest_rect, hwnd_override, dirty_region );
    }

    if ( !g_cl.m_is_running )
    {
        g_cl.on_directx_frame( device );

        if ( g_render.start_frame( device ) )
        {
            g_loading.draw( );
            g_render.end_frame( );
        }
    } else
    {
        g_ragebot.begin_render_frame( );

        if ( !g_input.window( ) )
        {
            g_input.attach_device( device );
        }

        g_cl.on_directx_frame( device );
        g_render.set_stream_proof( g_cfg.m_streamer_mode.m_stream_proof );

        if ( g_render.start_frame( device ) )
        {
            g_post_process.grade( );
            g_gui.draw_background( );

            g_esp_builder.begin_frame( );

            g_render.text( MENU_FONT( ),
                           point_t{ 8, g_cl.m_screen_height - 32 },
                           color_t{ 255, 255, 255, 128 },
                           ATLAS_XORSTR( "Build " CUR_COMMIT_HASH " at " __DATE__ " " __TIME__ "\nLast changes by: https://discord.gg/JtRXNunPf2" CUR_COMMIT_AUTHOR ).get( ),
                           true );

#if defined( ATLAS_DEV )
            g_render.text( MENU_FONT( ),
                           point_t{ g_cl.m_screen_width / 2, g_cl.m_screen_height - 32 },
                           color_t{ 255, 192, 192, 128 },
                           ATLAS_XORSTR( "Development build, for internal uses only. Do not distribute!\nAll things shown are not final and are subject to change at any time." ).get( ),
                           true, render::text_align::center );
#else
            // NOTE: Hoku; Might be a real retard decision of me, remove if this causes crashes.
            if ( !g_tf2.m_engine->IsInGame( ) )
            {
                g_render.text( MENU_FONT( ),
                               point_t{ g_cl.m_screen_width / 2, g_cl.m_screen_height - 32 },
                               color_t{ 255, 192, 192, 128 },
                               ATLAS_XORSTR( "Beta build, for testing purposes only.\nAll things shown are not final and are subject to change at any time." ).get( ),
                               true, render::text_align::center );
            }
#endif // ATLAS_DEV

            g_render.text( MENU_FONT( ),
                           point_t{ g_cl.m_screen_width - 8, g_cl.m_screen_height - 18 },
                           color_t{ 255, 255, 255, 128 },
                           g_api.user( ), true, render::text_align::right );

            g_input.begin_frame( );

            sync_menu_theme( );
            g_player_cloud.poll( );
            g_skins.sync_editor( );

            g_draw.traverse( );
            g_loading.draw( );

            draw_notifications( g_cl.m_screen_width, g_cl.m_screen_height );
            if ( g_cfg.m_misc.m_draw_watermark && g_loading.released( ) )
            {
                draw_watermark( g_cl.m_screen_width, g_cl.m_screen_height, watermark_values( ) );
            }

            g_proj_camera.paint( );
            g_tickbase.paint( );
            g_crits.paint( );
            g_nospread.paint( );
            g_radio.paint( );
            draw_spectator_list( );
            g_recorder.paint_keys( );

            g_gui.think( g_cl.m_screen_width, g_cl.m_screen_height );
            g_esp_builder.end_frame( );
            g_gui.draw( );
            g_render.end_frame( );

            u32 stream_proof_stage{ };
            u32 stream_proof_error{ };

            if ( g_render.consume_stream_proof_fallback( &stream_proof_stage, &stream_proof_error ) )
            {
                char message[ 160 ]{ };
                atl::format( message, sizeof( message ),
                             ATLAS_XORSTR( "Atlas is visible on stream. Overlay failed at stage %u, error %u (0x%X)." ).get( ),
                             stream_proof_stage, stream_proof_error, stream_proof_error );
                push_notification( notify_kind_t::warning, ICON_EYE, ATLAS_XORSTR_STATIC( "Stream proof" ), message );
            }
        }

        g_input.end_frame( );
    }

    return g_hooks.m_present.stdcall< i32 >( device, src_rect, dest_rect, hwnd_override, dirty_region );
}

i32 ATLAS_STDCALL hkReset(
    void                                *device,
    render::d3d9::D3DPRESENT_PARAMETERS *present_params )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_reset.stdcall< i32 >( device, present_params );
    }

    // FIXME: Hoku; This isn't correct at all. But until we get a proper pre/post-reset API call in render, this is what we have to do for now.
    g_esp_builder.on_device_lost( );
    g_chams.on_device_lost( );
    g_model_render.on_device_lost( );
    g_render.shutdown( );

    const auto status{ g_hooks.m_reset.stdcall< i32 >( device, present_params ) };
    if ( status >= render::d3d9::D3D_OK )
    {
        g_render.init( );
    }

    return status;
}

CUserCmd *ATLAS_THISCALL hkGetUserCmd(
    CInput *thisptr,
    i32     sequence_number )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_get_usercmd.thiscall< CUserCmd * >( thisptr, sequence_number );
    }

    return &thisptr->m_pCommands[ sequence_number % MULTIPLAYER_BACKUP ];
}

void ATLAS_THISCALL hkCreateMove(
    CInput *thisptr,
    i32     seq_number,
    float   input_sample_frametime,
    bool    active )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_create_move.thiscall< void >( thisptr, seq_number, input_sample_frametime, active );
    }

    ATLAS_INTEGRITY_CHECK( 0x1D5E8B42FA90C376ull );

    g_cl.m_psilent_choked = false;
    g_hooks.m_create_move.thiscall< void >( thisptr, seq_number, input_sample_frametime, active );
    g_networking.command_created( seq_number );

    g_input.suppress_binds( g_cl.game_owns_keyboard( ) );
    g_input.begin_command( );

    g_cl.m_cmd       = &thisptr->m_pCommands[ seq_number % MULTIPLAYER_BACKUP ];
    g_cl.m_will_fire = false;

    g_prediction.update( );
    g_cl.update_throw( );

    if ( !g_cl.m_cmd || !g_cl.m_local || !g_cl.m_weapon || !g_cl.m_local->IsAlive( ) )
    {
        g_cl.m_last_cmd = g_cl.m_cmd; // <- ?????
        return;
    }

    g_crits.on_create_move( seq_number );

    g_cl.m_cmd->random_seed = g_tf2.m_MD5_PseudoRandom.call_as< i32 >( g_cl.m_cmd->command_number ) & INT_MAX;
    g_tf2.m_CBaseEntity_SetPredictionRandomSeed.call_as< void >( g_cl.m_cmd );

    g_recorder.on_pre_prediction( );

    const auto va{ g_cl.m_cmd->viewangles };

    g_misc.on_pre_prediction( );
    g_fall_damage.run( );

    g_script_api.create_move_pre_pred( g_cl.m_cmd );

    g_extrapolate.update_local_input( );

    g_auto_rocketjmp.run( );

    g_nospread.pre_predict( );

    g_cl.m_will_fire = false;

    g_ragebot.maintain_managed_charge( );

    g_cl.apply_throw_angle( );

    g_tickbase.on_pre_prediction( );
    // switching can mutate a second weapon that is not in the preview's rollback snapshot..
    const bool predicted{ g_cl.m_cmd->weaponselect == 0 && g_prediction.start( seq_number ) };
    {
        g_fakelag.think( );
        g_anti_aim.think( );
        g_anti_backstab.think( );
        g_auto_vacc.run( );

        if ( predicted )
        {
            g_script_api.create_move( g_cl.m_cmd );
            g_misc.on_prediction( );
            g_air_blast.run( );
            g_auto_rocketjmp.run_predicted( );
            g_tickbase.on_prediction( );
        }
    }
    g_prediction.end( );

    g_crits.run( );
    g_auto_det.run( );

    g_script_api.create_move_post_pred( g_cl.m_cmd );
    g_holdaim_mgr.on_create_move( );

    g_cl.manage_psilent( );

    g_networking.gate_send( );
    g_cl.apply_throw_angle( );

    g_cl.fix_movement( g_cl.m_cmd, va );
    g_proj_sim.on_create_move( );
    g_trajectory.on_create_move( );
    g_proj_camera.on_create_move( );

    g_misc.on_post_prediction( );

    g_recorder.on_create_move_end( );

    g_cl.m_last_cmd = g_cl.m_cmd;

    if ( g_tf2.m_cl->chokedcommands >= MAX_SHIFT )
    {
        g_cl.m_send_packet = true;
        DBGOUT( "Failsafe triggered!" );
    }
}

bool ATLAS_THISCALL hkCheckInitPredictable( C_BaseEntity *thisptr )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_check_init_predictable.thiscall< bool >( thisptr );
    }

    const auto datamap{ thisptr->GetPredDescMap( ) };
    if ( datamap )
    {
        datamap->packed_offsets_computed = false;

        // Recursively walk the inheriting datamaps and null their compute flags.
        auto base_map{ datamap->baseMap };
        while ( base_map != nullptr )
        {
            base_map->packed_offsets_computed = false;
            base_map                          = base_map->baseMap;
        }
    }

    const bool fresh{ !thisptr->m_pOriginalData( ) };
    const bool result{ g_hooks.m_check_init_predictable.thiscall< bool >( thisptr ) };

    if ( fresh && thisptr->m_pOriginalData( ) )
    {
        g_crits.on_init_predictable( thisptr );
    }

    return result;
}

i32 ATLAS_CDECL hkS_StartSound( const StartSoundParams_t &params )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_s_start_sound.ccall< i32 >( params );
    }

    // static sounds are looping ambience owned by the world
    if ( !params.staticsound )
    {
        g_player_data.on_start_sound( params );
    }

    if ( g_cfg.m_misc.m_weapon_pitch != PITCH_NORM && g_misc.is_weapon_sound( params ) )
    {
        StartSoundParams_t pitched{ params };
        pitched.pitch = math::clamp( params.pitch * g_cfg.m_misc.m_weapon_pitch / PITCH_NORM, 1, 255 );

        return g_hooks.m_s_start_sound.ccall< i32 >( pitched );
    }

    return g_hooks.m_s_start_sound.ccall< i32 >( params );
}

void ATLAS_CDECL hkCL_Move( float accumulated_extra_samples, bool final_tick )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_cl_move.ccall< void >( accumulated_extra_samples, final_tick );
    }

    g_networking.report_cmdrate( );
    g_networking.remove_input_delay( final_tick );

    if ( g_tickbase.on_cl_move( accumulated_extra_samples, final_tick ) )
    {
        return;
    }

    g_networking.cl_move( accumulated_extra_samples, final_tick );
}

void ATLAS_THISCALL hkRunSimulation(
    CPrediction  *thisptr,
    i32           current_command,
    float         curtime,
    CUserCmd     *cmd,
    C_BasePlayer *local_player )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_run_simulation.thiscall< void >( thisptr, current_command, curtime, cmd, local_player );
    }

    if ( g_tickbase.on_run_simulation( local_player, current_command ) )
    {
        curtime = TICKS_TO_TIME( local_player->m_nTickBase( ) );
    }

    g_crits.on_run_simulation( current_command, cmd );

    local_player->m_vecPreviouslyPredictedOrigin( ) = local_player->m_vecOrigin( );
    g_doors.pose( current_command );
    g_anims.begin_local_command( local_player->As< C_TFPlayer * >( ), current_command, g_tickbase.seen_copies( ) );

    for ( CUserCmd copy{ }; g_tickbase.next_copy( local_player, current_command, copy ); )
    {
        g_anims.begin_copy( );
        g_hooks.m_run_simulation.thiscall< void >( thisptr, current_command - 1, TICKS_TO_TIME( local_player->m_nTickBase( ) ), &copy, local_player );
        g_anims.end_copy( );
    }

    g_hooks.m_run_simulation.thiscall< void >( thisptr, current_command, curtime, cmd, local_player );
    g_crits.on_run_simulation( -1, nullptr );
    g_doors.on_command_predicted( current_command, local_player );
    g_doors.restore( );

    g_compression.on_run_simulation( local_player, current_command );
}

void ATLAS_CDECL hkCL_ReadPackets( bool final_tick )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_cl_read_packets.ccall< void >( final_tick );
    }

    if ( !g_networking.should_read_packets( ) )
    {
        return;
    }

    g_hooks.m_cl_read_packets.ccall< void >( final_tick );
}

void ATLAS_THISCALL hkPacketStart( CClientState *thisptr, i32 incoming_sequence, i32 outgoing_acknowledged )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_packet_start.thiscall< void >( thisptr, incoming_sequence, outgoing_acknowledged );
    }

    const i32 acknowledged{ g_networking.acknowledged( outgoing_acknowledged ) };

    // the resolved value is the command the engine files as acked, which is also the command the
    // prediction error check pulls the intermediate frame for
    g_compression.on_packet_start( acknowledged );

    g_hooks.m_packet_start.thiscall< void >( thisptr, incoming_sequence, acknowledged );
}

void ATLAS_THISCALL hkSetChoked( CNetChannel *thisptr )
{
    g_hooks.m_net_chan_set_choked.thiscall< void >( thisptr );

    if ( !g_cl.m_is_running || thisptr != g_tf2.m_cl->m_NetChannel )
    {
        return;
    }

    g_networking.on_choked( );
}

void ATLAS_THISCALL hkDrawModel(
    CStudioRender      *thisptr,
    DrawModelResults_t *results,
    DrawModelInfo_t    *info,
    matrix3x4          *bone_to_world,
    float              *flex_weights,
    float              *flex_delayed_weights,
    const vec3         *model_origin,
    i32                 flags )
{
    if ( !g_cl.m_is_running || g_cl.should_perform_clean_frame( ) || g_proj_camera.drawing( ) )
    {
        return g_hooks.m_draw_model.thiscall< void >( thisptr, results, info, bone_to_world, flex_weights, flex_delayed_weights, model_origin, flags );
    }

    if ( g_glow.m_driving )
    {
        g_hooks.m_draw_model.thiscall< void >( thisptr, results, info, bone_to_world,
                                               flex_weights, flex_delayed_weights, model_origin, flags );
        return g_skins.draw_botkiller( thisptr, results, info, bone_to_world, model_origin, flags );
    }

    if ( g_chams.m_driving )
    {
        matrix3x4 *bones{ g_chams.record_bones( bone_to_world ) };

        g_hooks.m_draw_model.thiscall< void >( thisptr, results, info, bones,
                                               flex_weights, flex_delayed_weights, model_origin, flags );
        g_model_render.note_lod( info );
        return g_skins.draw_botkiller( thisptr, results, info, bones, model_origin, flags );
    }

    C_BaseEntity *entity{ };

    if ( info && info->m_pClientEntity )
    {
        auto           *renderable{ static_cast< IClientRenderable * >( info->m_pClientEntity ) };
        IClientUnknown *unknown{ renderable->GetIClientUnknown( ) };
        entity = unknown ? unknown->GetBaseEntity( ) : nullptr;
    }

    i32  draw_flags{ flags };
    bool glowed{ };

    if ( g_esp_builder.drawing( ) || g_chams.on_draw_model( results, info, bone_to_world, draw_flags ) )
    {
        g_esp_builder.route( entity, info, bone_to_world, draw_flags );
        glowed = entity && g_glow.begin_local_model( entity, *info, bone_to_world, draw_flags );

        g_hooks.m_draw_model.thiscall< void >( thisptr, results, info, bone_to_world, flex_weights, flex_delayed_weights, model_origin, draw_flags );

        if ( results )
        {
            g_model_render.note_lod( info );
        }

        g_skins.draw_botkiller( thisptr, results, info, bone_to_world, model_origin, flags );
    }

    g_chams.end_local_model( thisptr, results, info, bone_to_world, flex_weights,
                             flex_delayed_weights, model_origin, flags );

    if ( glowed )
    {
        return;
    }

    switch ( chams::local_model_kind( entity ) )
    {
        case config::LOCAL_MODEL_VIEWMODEL:
            g_glow.render_local_model( entity, g_cfg.m_glow.m_viewmodel, thisptr, results, info,
                                       bone_to_world, flex_weights, flex_delayed_weights,
                                       model_origin, flags );
            break;

        case config::LOCAL_MODEL_WEAPON:
            g_glow.render_local_model( entity, g_cfg.m_glow.m_weapon, thisptr, results, info,
                                       bone_to_world, flex_weights, flex_delayed_weights,
                                       model_origin, flags );
            break;

        default: break;
    }
}

void ATLAS_THISCALL hkInternalDrawModel(
    void                        *thisptr,
    const DrawModelInfo_t       &info,
    const StudioRenderContext_t &context,
    matrix3x4                   *bone_to_world,
    const FlexWeights_t         &flex,
    i32                          flags )
{
    const i32 engine_flags{ flags & ~model_render::ROUTE_MASK };

    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_internal_draw_model.thiscall< void >( thisptr, &info, &context, bone_to_world, &flex, engine_flags );
    }

    if ( ( flags & model_render::ROUTE_TAKEN_OVER ) && g_model_render.draw_in_place( info, flags ) )
    {
        return;
    }

    g_hooks.m_internal_draw_model.thiscall< void >( thisptr, &info, &context, bone_to_world, &flex, engine_flags );

    if ( flags & model_render::ROUTE_ENGINE_BASE )
    {
        g_model_render.draw_in_place( info, flags );
    }
}

void ATLAS_THISCALL hkDrawNoZBufferTranslucentRenderables( void *thisptr )
{
    if ( !g_cl.m_is_running || g_cl.should_perform_clean_frame( ) || g_proj_camera.drawing( ) )
    {
        return g_hooks.m_draw_no_z_translucent.thiscall< void >( thisptr );
    }

    g_model_render.finish_view( );
    g_hooks.m_draw_no_z_translucent.thiscall< void >( thisptr );
}

void ATLAS_THISCALL hkOverrideView( ClientModeShared *thisptr, CViewSetup *setup )
{
    if ( !g_cl.m_is_running || g_cl.should_perform_clean_frame( ) )
    {
        return g_hooks.m_override_view.thiscall< void >( thisptr, setup );
    }

    const vec3 eye{ setup ? setup->origin : vec3{ } };
    g_hooks.m_override_view.thiscall< void >( thisptr, setup );

    // g_viewmodel.on_override_view( setup );
    g_misc.on_override_view( setup, eye );
}

void ATLAS_THISCALL hkCalcViewModelView(
    C_BaseEntity *thisptr,
    C_BaseEntity *owner,
    vec3         &eye_position,
    vec3         &eye_angles )
{

    // fixes sway viewmodels going schizo with AA
    if ( !g_cl.m_is_running || g_cl.should_perform_clean_frame( ) || g_tf2.m_prediction->m_bInPrediction )
    {
        return g_hooks.m_calc_view_model_view.thiscall< void >( thisptr, owner, &eye_position, &eye_angles );
    }

    g_viewmodel.on_calc_view( eye_position, eye_angles );

    g_hooks.m_calc_view_model_view.thiscall< void >( thisptr, owner, &eye_position, &eye_angles );
}

f32 ATLAS_CDECL hkCalcViewModelBobHelper( C_BasePlayer *player, BobState_t *state )
{
    if ( !g_cl.m_is_running || g_cl.should_perform_clean_frame( ) )
    {
        return g_hooks.m_calc_view_model_bob_helper.thiscall< float >( player, state );
    }

    const f32 result{ g_hooks.m_calc_view_model_bob_helper.thiscall< float >( player, state ) };

    g_viewmodel.scale_bob( state );

    return result;
}

bool ATLAS_THISCALL hkShouldFlipViewModel( C_BaseViewModel *thisptr )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_should_flip_view_model.thiscall< bool >( thisptr );
    }

    return g_cl.m_vm_flipped = g_hooks.m_should_flip_view_model.thiscall< bool >( thisptr );
}

void ATLAS_CDECL hkHudCrosshairGetDrawPosition( f32 *x, f32 *y, bool *behind_camera, vec3 *angle_offset )
{
    if ( !g_cl.m_is_running || g_cl.should_perform_clean_frame( ) )
    {
        return g_hooks.m_hud_crosshair_get_draw_position.ccall< void >( x, y, behind_camera, angle_offset );
    }

    vec2 screen{ };
    if ( !g_ragebot.crosshair_position( screen ) )
    {
        return g_hooks.m_hud_crosshair_get_draw_position.ccall< void >( x, y, behind_camera, angle_offset );
    }

    *x             = screen.x;
    *y             = screen.y;
    *behind_camera = false;
}

void ATLAS_THISCALL hkAvoidPlayers( C_TFPlayer *thisptr, CUserCmd *cmd )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_avoid_players.thiscall< void >( thisptr, cmd );
    }

    if ( g_cfg.m_misc.m_removals[ config::REMOVAL_TEAM_PUSH ] )
    {
        return;
    }

    g_hooks.m_avoid_players.thiscall< void >( thisptr, cmd );
}

float ATLAS_THISCALL hkGetClientInterpAmount( )
{
    return 0.0f;
}

float ATLAS_THISCALL hkGetViewModelFOV( ClientModeShared *thisptr )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_get_view_model_fov.thiscall< float >( thisptr );
    }

    return g_hooks.m_get_view_model_fov.thiscall< float >( thisptr );
}

bool ATLAS_THISCALL hkDoPostScreenSpaceEffects( ClientModeShared *thisptr, const CViewSetup *setup )
{
    if ( !g_cl.m_is_running || g_cl.should_perform_clean_frame( ) || g_proj_camera.drawing( ) )
    {
        return g_hooks.m_do_post_screen_space_effects.thiscall< bool >( thisptr, setup );
    }

    g_model_render.end_scene( );

    {
        g_chams.render_main( );
        g_glow.render_main( );
    }

    if ( g_cfg.m_misc.m_removals[ config::REMOVAL_POST_FX ] )
    {
        return false;
    }

    return g_hooks.m_do_post_screen_space_effects.thiscall< bool >( thisptr, setup );
}

void ATLAS_THISCALL hkLevelInitPreEntity( CHLClient *thisptr, const char *map_name )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_level_init_pre_entity.thiscall< void >( thisptr, map_name );
    }

    if ( !g_entity_cache.update( ) )
    {
        g_cl.m_is_running = false;
        DBGOUT( "entity cache: initialization failed" );
        return g_hooks.m_level_init_pre_entity.thiscall< void >( thisptr, map_name );
    }

    g_cl.m_has_been_in_game_and_alive_once = false;
    g_chams.on_level_init( );
    g_splash.clear( );
    g_glow.on_level_init( );
    g_esp_builder.on_level_init( );
    g_weather.on_level_init( );
    g_world_modulation.on_level_init( );
    g_anims.clear( );
    g_bone_mgr.clear( );
    g_lagcomp.clear( );
    g_resolver.clear( );
    g_extrapolate.clear( );
    g_holdaim_mgr.reset( );
    g_networking.clear( );
    g_tickbase.clear( );
    g_prediction.shutdown( );
    g_doors.clear( );
    g_fake_latency.clear( );
    g_cl.m_psilent_choked  = false;
    g_cl.m_psilent_release = false;
    g_compression.clear( );
    g_crits.clear( );
    g_player_data.on_level_shutdown( );
    g_player_cloud.on_level_shutdown( );
    g_auto_vacc.clear( );
    g_auto_det.clear( );
    g_watchdog.clear( );
    g_player_perf.clear( );

    g_fakelag.reset( );
    g_anti_aim.reset( );

    g_cl.clear_throw( );
    g_cl.m_local    = nullptr;
    g_cl.m_weapon   = nullptr;
    g_cl.m_resource = nullptr;

    g_script_api.level_init( );
    g_recorder.on_level_init( map_name );

    return g_hooks.m_level_init_pre_entity.thiscall< void >( thisptr, map_name );
}

void ATLAS_THISCALL hkForcedMaterialOverride( CStudioRender *thisptr, IMaterial *material, OverrideType_t override_type )
{
