void ATLAS_THISCALL hkInsertAndColorizeText( void *thisptr, wchar_t *buffer, i32 idx )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_insert_and_colorize_text.thiscall< void >( thisptr, buffer, idx );
    }

    if ( !g_cl.m_local ||
         !g_cl.m_resource ||
         idx <= 0 ||
         idx > g_tf2.m_engine->GetMaxClients( ) )
    {
        return g_hooks.m_insert_and_colorize_text.thiscall< void >( thisptr, buffer, idx );
    }

    player_info_t info{ };
    if ( !g_tf2.m_engine->GetPlayerInfo( idx, &info ) )
    {
        return g_hooks.m_insert_and_colorize_text.thiscall< void >( thisptr, buffer, idx );
    }

    wchar_t player_name[ MAX_PLAYER_NAME_LENGTH ]{ };
    if ( !I( MultiByteToWideChar )( CP_UTF8, 0, info.name, -1, player_name, MAX_PLAYER_NAME_LENGTH ) )
    {
        return g_hooks.m_insert_and_colorize_text.thiscall< void >( thisptr, buffer, idx );
    }

    // TODO: Might not be the most optimal? We're technically replacing the string every single time this function is called.
    // So even if the player doesn't need their name replaced it gets replaced anyways.
    const char *replacement{ g_cl.get_player_name( idx ) };
    wchar_t     replacement_name[ MAX_PLAYER_NAME_LENGTH ]{ };
    if ( !I( MultiByteToWideChar )( CP_UTF8, 0, replacement, -1, replacement_name, MAX_PLAYER_NAME_LENGTH ) )
    {
        return g_hooks.m_insert_and_colorize_text.thiscall< void >( thisptr, buffer, idx );
    }

    constexpr usize buffer_capacity{ 1024 };
    const usize     buffer_length{ str::bounded_length( buffer, buffer_capacity ) };
    if ( buffer_length == buffer_capacity )
    {
        return g_hooks.m_insert_and_colorize_text.thiscall< void >( thisptr, buffer, idx );
    }

    const atl::wstring_view text{ buffer, buffer_length };
    const atl::wstring_view name{ player_name };
    if ( name.empty( ) )
    {
        return g_hooks.m_insert_and_colorize_text.thiscall< void >( thisptr, buffer, idx );
    }

    const usize name_start{ text.find( name ) };
    if ( name_start == str::npos )
    {
        return g_hooks.m_insert_and_colorize_text.thiscall< void >( thisptr, buffer, idx );
    }

    const atl::wstring_view replacement_view{ replacement_name };
    const usize             player_name_end{ name_start + name.size( ) };
    const usize             suffix_start{ player_name_end < text.size( ) ? player_name_end + 1 : player_name_end };
    const usize             new_length{ name_start + replacement_view.size( ) + 1 + text.size( ) - suffix_start };
    if ( new_length >= buffer_capacity )
    {
        return g_hooks.m_insert_and_colorize_text.thiscall< void >( thisptr, buffer, idx );
    }

    atl::wstring< buffer_capacity - 1 > sanitized_buffer{ };
    sanitized_buffer.append( text.substr( 0, name_start ) );
    sanitized_buffer.append( replacement_view );
    sanitized_buffer.push_back( L'\x1' );
    sanitized_buffer.append( text.substr( suffix_start ) );

    if ( sanitized_buffer[ 0 ] == L'\x2' )
    {
        sanitized_buffer[ 0 ] = L'\x3';
    }

    return g_hooks.m_insert_and_colorize_text.thiscall< void >( thisptr, sanitized_buffer.data( ), idx );
}

void ATLAS_THISCALL hkVerifyChangedLoadoutsAreValid( void *thisptr )
{
    if ( !g_cl.m_is_running || g_cfg.m_misc.m_removals[ config::REMOVAL_EQUIP_REGIONS ] == false )
    {
        return g_hooks.m_verify_changed_loadouts_are_valid.thiscall< void >( thisptr );
    }

    DBGOUT( "Prevented loadout verification from happening." );
}

u32 ATLAS_CDECL hkGenerateEquipRegionConflictMask( i32 player_class, i32 up_to_slot, i32 ignore_slot )
{
    if ( !g_cl.m_is_running || g_cfg.m_misc.m_removals[ config::REMOVAL_EQUIP_REGIONS ] == false )
    {
        return g_hooks.m_generate_equip_region_conflict_mask.ccall< u32 >( player_class, up_to_slot, ignore_slot );
    }

    return 0;
}

void *ATLAS_THISCALL hkGetItemInLoadoutForClass( void *thisptr, i32 player_class, i32 slot, steamid_t *sid )
{
    if ( !g_cl.m_is_running || g_cfg.m_misc.m_removals[ config::REMOVAL_EQUIP_REGIONS ] == false )
    {
        return g_hooks.m_get_item_in_loadout_for_class.thiscall< void * >( thisptr, player_class, slot, sid );
    }

    const auto retaddr{ ( uptr )__builtin_return_address( 0 ) };
    if ( retaddr == g_tf2.m_CTFInventoryManager_GetItemInLoadoutForClass_retaddr.get_raw( ) )
    {
        return nullptr;
    }

    return g_hooks.m_get_item_in_loadout_for_class.thiscall< void * >( thisptr, player_class, slot, sid );
}

const char *ATLAS_THISCALL hkGetShootSound( C_TFWeaponBase *thisptr, i32 index )
{
    if ( !g_cl.m_is_running || !g_cfg.m_misc.m_giant_weapon_sounds || thisptr != g_cl.m_weapon )
    {
        return g_hooks.m_get_shoot_sound.thiscall< const char * >( thisptr, index );
    }

    i32 &team{ thisptr->m_iTeamNum( ) };
    u16 &econ_id{ thisptr->m_iItemDefinitionIndex( ) };

    const i32 original_team{ team };
    const u16 original_econ{ econ_id };

    if ( g_cfg.m_misc.m_apply_to_alternate_weapons )
    {
        switch ( thisptr->GetWeaponID( ) )
        {
            case TF_WEAPON_ROCKETLAUNCHER:
            {
                econ_id = Soldier_m_RocketLauncher;
                break;
            }

            case TF_WEAPON_GRENADELAUNCHER:
            {
                econ_id = Demoman_m_GrenadeLauncher;
                break;
            }

            case TF_WEAPON_FLAMETHROWER:
            {
                econ_id = Pyro_m_FlameThrower;
                break;
            }

            default: break;
        }
    }

    team = TF_TEAM_PVE_INVADERS_GIANTS;
    const char *sound{ g_hooks.m_get_shoot_sound.thiscall< const char * >( thisptr, index ) };
    team    = original_team;
    econ_id = original_econ;

    return g_misc.giant_shoot_sound( sound );
}

void ATLAS_CDECL hkCbuf_ExecuteCommand( const CCommand &args, cmd_source_t source )
{
    if ( !g_cl.m_is_running || args.m_ppArgv[ 0 ] == nullptr )
    {
        return g_hooks.m_cbuf_execute_command.ccall< void >( args, source );
    }

    const auto cmd_hash{ HASH_RT( args.m_ppArgv[ 0 ] ) };

    switch ( cmd_hash )
    {
        case HASH_CT( "cl_interp" ):
        case HASH_CT( "cl_interpolate" ):
        case HASH_CT( "cl_interp_ratio" ):
        case HASH_CT( "cl_cmdrate" ):
        case HASH_CT( "cl_updaterate" ):
        case HASH_CT( "cl_smooth" ):
        case HASH_CT( "cl_interp_all" ):
        case HASH_CT( "cl_predict" ):
        case HASH_CT( "cl_predictweapons" ):
        case HASH_CT( "cl_pred_optimize" ):
        case HASH_CT( "cl_lagcompensation" ):
        {
            DBGOUT( "Prevented a networking command from being changed." );
            push_notification( notify_kind_t::warning, ICON_CODE, ATLAS_XORSTR( "ConVars" ).get( ), ATLAS_XORSTR( "Prevented a critical networking ConVar from being changed!" ).get( ) );
            return;
        }

        case HASH_CT( "setinfo" ):
        {
            if ( args.m_ppArgv[ 1 ] == nullptr )
            {
                break;
            }

            const auto set_target_hash{ HASH_RT( args.m_ppArgv[ 1 ] ) };
            switch ( set_target_hash )
            {
                case HASH_CT( "cl_interp" ):
                case HASH_CT( "cl_interpolate" ):
                case HASH_CT( "cl_interp_ratio" ):
                case HASH_CT( "cl_cmdrate" ):
                case HASH_CT( "cl_updaterate" ):
                case HASH_CT( "cl_smooth" ):
                case HASH_CT( "cl_interp_all" ):
                case HASH_CT( "cl_predict" ):
                case HASH_CT( "cl_predictweapons" ):
                case HASH_CT( "cl_pred_optimize" ):
                case HASH_CT( "cl_lagcompensation" ):
                {
                    DBGOUT( "Prevented a networking command from being changed through setinfo!" );
                    push_notification( notify_kind_t::warning, ICON_CODE, ATLAS_XORSTR( "ConVars" ).get( ), ATLAS_XORSTR( "Prevented a critical networking convar from being changed!" ).get( ) );
                    return;
                }

                default: break;
            }
        }

        default: break;
    }

    g_hooks.m_cbuf_execute_command.ccall< void >( args, source );
}

i32 ATLAS_CDECL hkNotificationQueue_Add( CEconNotification *notif )
{
    if ( !g_cl.m_is_running || !notif || g_cfg.m_misc.m_removals[ config::REMOVAL_ITEM_NOTIFICATIONS ] == false )
    {
        return g_hooks.m_notification_queue_add.ccall< i32 >( notif );
    }

    Assert( notif != nullptr );
    if ( str::equals( notif->m_pText, ATLAS_XORSTR( "TF_HasNewItems" ).get( ) ) )
    {
        notif->Destroy( ); // this is more simple and on theory should work and fix the crashes.
        return 0;
    }

    return g_hooks.m_notification_queue_add.ccall< i32 >( notif );
}
