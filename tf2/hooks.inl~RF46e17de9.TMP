    g_cl.m_has_been_in_game_and_alive_once = false;
    g_esp.on_level_shutdown( );
    g_hitmarker.clear( );
    g_prediction.shutdown( );
    g_doors.clear( );
    g_skins.on_level_shutdown( );
    g_chams.on_level_shutdown( );
    g_glow.on_level_shutdown( );
    g_proj_camera.on_level_shutdown( );
    g_trajectory.clear( );
    g_projectile_warning.on_level_shutdown( );
    g_esp_builder.on_level_shutdown( );
    g_tickbase.clear( );
    g_fake_latency.clear( );
    g_networking.clear( );
    g_nospread.clear( );
    g_holdaim_mgr.reset( );
    g_weather.on_level_shutdown( );
    g_radio.on_level_shutdown( );
    g_soundboard.on_level_shutdown( );
    g_crits.clear( );
    g_player_data.on_level_shutdown( );
    g_player_cloud.on_level_shutdown( );
    g_auto_vacc.clear( );
    g_auto_det.clear( );
    g_watchdog.clear( );
    g_player_perf.clear( );
    g_proj_sim.shutdown( );
    g_tracers.clear( );
    g_medbot.on_level_shutdown( );
    g_recorder.on_level_shutdown( );
    g_script_api.level_shutdown( );
    g_world_modulation.on_level_shutdown( );

    g_fakelag.reset( );
    g_anti_aim.reset( );

    g_cl.clear_throw( );
    g_cl.m_local    = nullptr;
    g_cl.m_weapon   = nullptr;
    g_cl.m_resource = nullptr;

    g_hooks.m_level_shutdown.thiscall< void >( thisptr );
    g_entity_cache.on_level_shutdown( );
}

void ATLAS_THISCALL hkFrameStageNotify( CHLClient *thisptr, ClientFrameStage_t stage )
{
    g_session.poll( );
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_frame_stage_notify.thiscall< void >( thisptr, stage );
    }
    ATLAS_INTEGRITY_CHECK( 0x3A70C1F5E28B4D69ull );

    if ( !g_entity_cache.update( ) )
    {
        g_cl.m_is_running = false;
        DBGOUT( "entity cache: update failed before frame stage %i", static_cast< i32 >( stage ) );
        return g_hooks.m_frame_stage_notify.thiscall< void >( thisptr, stage );
    }

    switch ( stage )
    {
        case FRAME_NET_UPDATE_POSTDATAUPDATE_START:
        {
            g_skins.think( );
            break;
        }

        case FRAME_NET_UPDATE_POSTDATAUPDATE_END:
        {
            g_compression.restore( );
            break;
        }

        default: break;
    }

    g_hooks.m_frame_stage_notify.thiscall< void >( thisptr, stage );

    if ( !g_entity_cache.update( ) )
    {
        g_cl.m_is_running = false;
        DBGOUT( "entity cache: update failed after frame stage %i", static_cast< i32 >( stage ) );
        return;
    }

    switch ( stage )
    {
        case FRAME_NET_UPDATE_POSTDATAUPDATE_END:
        {
            g_cl.update_local_data( );
            g_player_data.hold_stale_simulation_times( );

            if ( !g_cl.m_has_been_in_game_and_alive_once && client::is_in_game_and_alive( ) )
            {
                g_cl.m_has_been_in_game_and_alive_once = true;
            }

            if ( g_cl.m_has_been_in_game_and_alive_once )
            {
                g_cl.m_target_config_profile = client::get_profile( );
            }

            g_prediction.on_post_data_update( );
            g_anims.on_post_data_update( );
            g_doors.on_post_data_update( );
            g_tickbase.on_post_data_update( );
            g_player_data.update( );
            g_move_sim.observe_air( );
            g_esp.think( );
            break;
        }

        case FRAME_NET_UPDATE_END:
        {
            g_cl.refresh_party( );
            g_cl.refresh_lobby_parties( );
            g_party_network.think( );
            g_auto_vacc.on_network_update( );
            g_auto_det.on_network_update( );
            g_projectile_warning.on_network_update( );
            g_crits.on_network_update( );
            g_watchdog.on_network_update( );
            g_resolver.think( );

            if ( !g_anims.defer_update( ) )
            {
                g_anims.update_others( );
                g_lagcomp.update( );
            }

            break;
        }

        case FRAME_RENDER_START:
        {
            g_model_render.begin_frame( );
            g_input.seal_batch( );
            g_weather.think( );
            g_skybox.think( );
            g_world_modulation.think( );
            break;
        }

        case FRAME_RENDER_END:
        {
            g_model_render.end_frame( );
            break;
        }

        default: break;
    }

    g_script_api.frame_stage( stage );
}

