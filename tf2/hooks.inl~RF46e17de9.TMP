void ATLAS_THISCALL hkResetLatched( C_BaseEntity *thisptr )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_reset_latched.thiscall< void >( thisptr );
    }

    if ( thisptr == g_cl.m_local )
    {
        return;
    }

    g_hooks.m_reset_latched.thiscall< void >( thisptr );
}

// Prevents our noisemaker from getting used on the client if we decide to use it normally.
// Also should allow us to use our noisemakers when dead or in spectator.
void ATLAS_THISCALL hkOnClientUseConsumable( void *thisptr, void **pItem, void **pParent )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_on_client_use_consumable.thiscall< void >( thisptr, pItem, pParent );
    }

    if ( !g_cl.m_local )
    {
        return;
    }

    const auto shared_data{ g_cl.m_local->GetSharedPlayerData( ) };
    if ( !shared_data )
    {
        return;
    }

    if ( g_tf2.m_globals->curtime < shared_data->m_flNextNoiseMakerTime( ) )
    {
        return;
    }

    auto kv{ new KeyValues( ATLAS_XORSTR_STATIC( "use_action_slot_item_server" ) ) };
    g_tf2.m_engine->ServerCmdKeyValues( kv );
}

void ATLAS_THISCALL hkSetCursor( CMatSystemSurface *thisptr, vgui::HCursor hCursor )
{
    if ( !g_cl.m_is_running || !g_gui.open( ) )
    {
        return g_hooks.m_set_cursor.thiscall< void >( thisptr, hCursor );
    }

    switch ( g_gui.get_cursor_state( ) )
    {
        case gui::CURSOR_STATE_ARROW: hCursor = vgui::dc_arrow; break;
        case gui::CURSOR_STATE_CLICK_HAND: hCursor = vgui::dc_hand; break;
        case gui::CURSOR_STATE_TEXT_BEAM: hCursor = vgui::dc_ibeam; break;
        case gui::CURSOR_STATE_RESIZE_NESW: hCursor = vgui::dc_sizenesw; break;
        case gui::CURSOR_STATE_RESIZE_NWSE: hCursor = vgui::dc_sizenwse; break;
        default: hCursor = vgui::dc_arrow; break; // Incase we somehow get a cursor state we don't support yet...
    }

    g_hooks.m_set_cursor.thiscall< void >( thisptr, hCursor );
}

void ATLAS_THISCALL hkLockCursor( CMatSystemSurface *thisptr )
{
    if ( !g_cl.m_is_running || !g_gui.open( ) )
    {
        return g_hooks.m_lock_cursor.thiscall< void >( thisptr );
    }

    g_tf2.m_surface->UnlockCursor( );
