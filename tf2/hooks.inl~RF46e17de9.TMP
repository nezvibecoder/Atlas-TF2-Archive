void *ATLAS_THISCALL hkGetModel( IClientRenderable *thisptr, i32 model_index )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_get_model.thiscall< void * >( thisptr, model_index );
    }

    if ( void *model{ g_skins.model_for_index( model_index ) } )
    {
        return model;
    }

    if ( void *model{ g_esp_builder.model_for_index( model_index ) } )
    {
        return model;
    }

    return g_hooks.m_get_model.thiscall< void * >( thisptr, model_index );
}

void *ATLAS_THISCALL hkLightcacheGetDynamic(
    void             *thisptr,
    vec3             *origin,
    lighting_state_t *state,
    void             *unknown,
    i32               flags,
    bool              skip )
{
    if ( !g_cl.m_is_running || g_tf2.m_engine->IsInGame( ) )
    {
        return g_hooks.m_lightcache_get_dynamic.thiscall< void * >( thisptr, origin, state, unknown, flags, skip );
    }

    if ( !state )
    {
        return nullptr;
    }

    for ( i32 index{ }; index < 6; ++index )
    {
        state->m_box_color[ index ] = vec3{ 0.5f, 0.5f, 0.5f };
    }

    for ( i32 index{ }; index < 4; ++index )
    {
        state->m_local_light[ index ] = nullptr;
    }

    state->m_light_count = 0;
    return nullptr;
}

void *ATLAS_THISCALL hkMinigunOnNewModel( C_TFMinigun *thisptr )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_minigun_on_new_model.thiscall< void * >( thisptr );
    }

    const float current{ thisptr->m_flBarrelCurrentVelocity( ) };
    const float target{ thisptr->m_flBarrelTargetVelocity( ) };
    const float angle{ thisptr->m_flBarrelAngle( ) };

    const auto original{ g_hooks.m_minigun_on_new_model.thiscall< void * >( thisptr ) };

    thisptr->m_flBarrelCurrentVelocity( ) = current;
    thisptr->m_flBarrelTargetVelocity( )  = target;
    thisptr->m_flBarrelAngle( )           = angle;

    return original;
}

void ATLAS_THISCALL hkSetDormant( C_BaseEntity *thisptr, bool dormant )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_set_dormant.thiscall< void >( thisptr, dormant );
    }

    g_player_data.on_set_dormant( thisptr, dormant );

    g_hooks.m_set_dormant.thiscall< void >( thisptr, dormant );
}

void *ATLAS_THISCALL hkUpdateVisibility( C_BaseEntity *thisptr )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_update_visibility.thiscall< void * >( thisptr );
    }

    if ( thisptr && thisptr == g_esp_builder.entity( ) )
    {
        return nullptr;
    }

    return g_hooks.m_update_visibility.thiscall< void * >( thisptr );
}

bool ATLAS_THISCALL hkSetupBones(
    IClientRenderable *thisptr,
    matrix3x4         *bone_to_world,
    i32                max_bones,
    i32                bone_mask,
    float              current_time )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_setup_bones.thiscall< bool >( thisptr, bone_to_world, max_bones, bone_mask, current_time );
    }

    C_BaseEntity *entity{ reinterpret_cast< C_BaseEntity * >( reinterpret_cast< uptr >( thisptr ) - 0x8 ) };
    if ( g_esp_builder.on_setup_bones( entity, bone_to_world, max_bones ) )
    {
        return true;
    }

    ClientClass *client_class{ entity->GetClientClass( ) };

    if ( client_class &&
         client_class->GetClassID( ) == ETFClassID::CTFPlayer &&
         g_bone_mgr.player_setup( entity->As< C_TFPlayer * >( ), bone_to_world, max_bones, bone_mask ) )
    {
        return true;
    }

    return g_hooks.m_setup_bones.thiscall< bool >( thisptr, bone_to_world, max_bones, bone_mask, current_time );
}

void ATLAS_THISCALL hkAnimStateDoAnimationEvent( CTFPlayerAnimState *thisptr, i32 event, i32 data )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_anim_state_do_animation_event.thiscall< void >( thisptr, event, data );
    }

    thisptr->ClearStaleSwimming( );
    C_BaseEntity *player{ thisptr->m_pEntity( ) };
    if ( player && player == g_cl.m_local )
    {
        g_anims.record_local_event( g_cl.m_local, event, data );
    }

    if ( !player || player == g_cl.m_local || g_anims.replay_velocity( player ) ||
         player->As< C_TFPlayer * >( )->InCond( TF_COND_TAUNTING ) )
    {
        return g_hooks.m_anim_state_do_animation_event.thiscall< void >( thisptr, event, data );
    }

    // a packet's events wait for the replay of its batch, which runs each on the command it belongs to
    if ( !g_anims.queue_event( player, event, data ) )
    {
        g_anims.play_event( thisptr, player, event, data );
    }
}

bool ATLAS_THISCALL hkBaseAnimatingInterpolate( C_BaseEntity *thisptr, float current_time )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_base_animating_interpolate.thiscall< bool >( thisptr, current_time );
    }

    if ( ClientClass *client_class{ thisptr->GetClientClass( ) }; client_class->GetClassID( ) == ETFClassID::CTFPlayer )
    {
        if ( thisptr->entindex( ) != g_tf2.m_engine->GetLocalPlayer( ) )
        {
            return true;
        } else
        {
            if ( !g_interp_mgr.should_interpolate_local( ) )
            {
                return true;
            }
        }
    }

    return g_hooks.m_base_animating_interpolate.thiscall< bool >( thisptr, current_time );
}

void ATLAS_FASTCALL hkUpdateClientSideAnimation( C_TFPlayer *thisptr )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_update_client_side_animation.thiscall< void >( thisptr );
    }

    if ( thisptr->InCond( TF_COND_TAUNTING ) )
    {
        g_hooks.m_update_client_side_animation.thiscall< void >( thisptr );
    }
}

void ATLAS_FASTCALL hkBuildTransformations(
    C_TFPlayer      *thisptr,
    CStudioHdr      *studio,
    vec3            *pos,
    quaternion      *q,
    const matrix3x4 *camera_transform,
    i32              bone_mask,
    void            *bone_computed )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_build_transformations.thiscall< void >(
            thisptr,
            studio,
            pos,
            q,
            camera_transform,
            bone_mask,
            bone_computed );
    }

    const i32 flags{ thisptr->m_fFlags( ) };
    thisptr->m_fFlags( ) &= ~FL_DUCKING;
    g_hooks.m_build_transformations.thiscall< void >(
        thisptr,
        studio,
        pos,
        q,
        camera_transform,
        bone_mask,
        bone_computed );
    thisptr->m_fFlags( ) = flags;
}

void ATLAS_FASTCALL hkComputeAimYaw( CTFPlayerAnimState *thisptr, void *studio )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_compute_aim_yaw.thiscall< void >( thisptr, studio );
    }

    g_hooks.m_compute_aim_yaw.thiscall< void >( thisptr, studio );

    C_BaseEntity *player{ thisptr->m_pEntity( ) };

    if ( !player )
    {
        return;
    }

    vec3 angles{ player->GetAbsAngles( ) };
    angles.y = thisptr->m_flCurrentFeetYaw( ); // server does it, we do it as well.

    g_tf2.m_CBaseEntity_SetAbsAngles.call_as< void, C_BaseEntity *, const vec3 & >( player, angles );
}

