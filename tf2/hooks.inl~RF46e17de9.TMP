    vec3       *pos,
    quaternion *q )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_maintain_sequence_transitions.thiscall< void >( thisptr, setup, cycle, pos, q );
    }
}

void ATLAS_FASTCALL hkCheckForSequenceChange(
    void       *thisptr,
    CStudioHdr *studio,
    i32         sequence,
    bool        force_new_sequence,
    bool        interpolate )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_check_for_sequence_change.thiscall< void >( thisptr, studio, sequence, force_new_sequence, interpolate );
    }

    g_hooks.m_check_for_sequence_change.thiscall< void >( thisptr, studio, sequence, force_new_sequence, false );
}

void ATLAS_FASTCALL hkSetSequence( C_BaseAnimating *thisptr, i32 sequence )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_set_sequence.thiscall< void >( thisptr, sequence );
    }

    const auto cc{ thisptr->GetClientClass( ) };
    if ( !cc )
    {
        return g_hooks.m_set_sequence.thiscall< void >( thisptr, sequence );
    }

    if ( cc->GetClassID( ) != ETFClassID::CTFPlayer )
    {
        return g_hooks.m_set_sequence.thiscall< void >( thisptr, sequence );
    }

    // CBaseAnimating::ResetSequence reads the loop flag ResetSequenceInfo cached, not the current sequence's: SetModel's
    // SetSequence( 0 ) on a respawn leaves it on the last life's run, so the server carries the cycle into the new class.
    if ( thisptr->m_nSequence( ) != sequence && !thisptr->m_bSequenceLoops( ) )
    {
        thisptr->m_flCycle( ) = 0.0f;
    }

    g_hooks.m_set_sequence.thiscall< void >( thisptr, sequence );
}

i32 ATLAS_FASTCALL hkBaseInterpolatePart1(
    C_BaseEntity *thisptr,
    float        *current_time,
    vec3         *old_origin,
    vec3         *old_angles,
    vec3         *old_velocity,
    i32          *no_more_changes )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_base_interpolate_part1.thiscall< i32 >( thisptr, current_time, old_origin, old_angles, old_velocity, no_more_changes );
    }

    if ( g_tickbase.recharging( ) || g_tickbase.shifting( ) )
    {
        *no_more_changes = 1;
        return INTERPOLATE_STOP;
    }

    return g_hooks.m_base_interpolate_part1.thiscall< i32 >( thisptr, current_time, old_origin, old_angles, old_velocity, no_more_changes );
}

void ATLAS_FASTCALL hkInterpolateServerEntities( )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_interpolate_server_entities.ccall< void >( );
    }

    if ( g_tickbase.recharging( ) || g_tickbase.shifting( ) )
    {
        if ( bool *flag{ g_tf2.m_interpolate_flag.get_as< bool * >( ) } )
        {
            *flag = false; // fuck you
        }

        return;
    }

    g_hooks.m_interpolate_server_entities.ccall< void >( );
}

bool ATLAS_THISCALL hkIsPaused( CClientState *thisptr )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_client_state_is_paused.thiscall< bool >( thisptr );
    }

    if ( reinterpret_cast< uptr >( __builtin_return_address( 0 ) ) == g_tf2.m_enable_extrapolation_retaddr.get_raw( ) )
    {
        return true;
    }

    return g_hooks.m_client_state_is_paused.thiscall< bool >( thisptr );
}

f32 ATLAS_THISCALL hkGetTime( CClientState *thisptr )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_client_state_get_time.thiscall< f32 >( thisptr );
    }

    if ( reinterpret_cast< uptr >( __builtin_return_address( 0 ) ) == g_tf2.m_cl_fire_events_retaddr.get_raw( ) )
    {
        return FLT_MAX;
    }

    return g_hooks.m_client_state_get_time.thiscall< f32 >( thisptr );
}

bool ATLAS_THISCALL hkSendNetMsg( CNetChannel *thisptr, INetMessage &message, bool force_reliable, bool voice )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_net_chan_send_net_msg.thiscall< bool >( thisptr, &message, force_reliable, voice );
    }

    const bool result{ g_hooks.m_net_chan_send_net_msg.thiscall< bool >( thisptr, &message, force_reliable, voice ) };

    if ( result && g_cfg.m_exploits.m_ping_reducer && message.GetType( ) == net_SetConVar )
    {
        g_networking.send_reported_cmdrate( thisptr, true );
    }

    return result;
}

void ATLAS_THISCALL hkProcessPacket( CNetChannel *thisptr, void *packet, bool has_header )
{
    if ( !g_cl.m_is_running || thisptr != g_tf2.m_cl->m_NetChannel )
    {
        return g_hooks.m_net_chan_process_packet.thiscall< void >( thisptr, packet, has_header );
    }

    const double received_time{ tick_manager::packet_time( thisptr->IsLoopback( ) ) };
    const i32    previous_sequence{ thisptr->m_nInSequenceNr };
    g_fake_latency.begin_packet( thisptr, has_header );
    g_anims.begin_packet( );
    g_hooks.m_net_chan_process_packet.thiscall< void >( thisptr, packet, has_header );
    g_fake_latency.end_packet( thisptr, received_time );
    const bool animation_update{ g_anims.end_packet( ) };

    if ( !g_cl.m_is_running || thisptr != g_tf2.m_cl->m_NetChannel )
    {
        return;
    }

    if ( has_header && thisptr->m_nInSequenceNr == previous_sequence )
    {
        return;
    }

    g_tickbase.observe_server_tick( );
    g_player_perf.on_packet( );
    g_nospread.on_packet( thisptr );

    if ( CEventInfo * *queue{ g_tf2.m_cl_event_queue.get_as< CEventInfo ** >( ) } )
    {
        for ( CEventInfo *event{ *queue }; event; event = event->m_next )
        {
            event->m_fire_delay = 0.0f;
        }
    }

    g_anims.begin_events( animation_update );
    g_tf2.m_engine->FireEvents( );

    // NET_UPDATE_END is inside packet-entities processing; Temp entities later
    // in this packet must be applied before its animation pose/history is saved
    if ( animation_update && g_cl.m_is_running && thisptr == g_tf2.m_cl->m_NetChannel )
    {
        g_anims.update_others( );
        g_lagcomp.update( );
    }

    g_anims.end_events( );
}

bool ATLAS_THISCALL hkReadSubChannelData( CNetChannel *thisptr, bf_read *buffer, i32 stream )
{
    if ( !g_cl.m_is_running || thisptr != g_tf2.m_cl->m_NetChannel || !g_fake_latency.filtering( thisptr ) )
    {
        return g_hooks.m_net_chan_read_sub_channel_data.thiscall< bool >( thisptr, buffer, stream );
    }

    if ( g_fake_latency.skip_block( thisptr, *buffer, stream ) )
    {
        return true;
    }

    const bool accepted{ g_hooks.m_net_chan_read_sub_channel_data.thiscall< bool >( thisptr, buffer, stream ) };
    if ( accepted )
    {
        g_fake_latency.accept_block( stream );
    }

    return accepted;
}

void ATLAS_FASTCALL hkPostThink( C_BasePlayer *thisptr )
{
    if ( !g_cl.m_is_running )
    {
        return g_hooks.m_post_think.thiscall< void >( thisptr );
    }

    if ( g_prediction.m_is_active )
    {
        g_prediction.post_think( );
        return;
    }

    g_hooks.m_post_think.thiscall< void >( thisptr );

    if ( thisptr == g_cl.m_local )
    {
        g_anims.update_local( g_cl.m_local );
    }
}

ATLAS_FORCE_INLINE void prepare_weapon_preview( C_TFWeaponBase *weapon )
{
    if ( !g_prediction.m_is_active || weapon != g_cl.m_weapon || !g_prediction.begin_weapon( ) )
    {
        return;
    }

    g_ragebot.think( );
    g_melee.think( );
    g_holdaim_mgr.on_create_move( );
    g_nospread.create_move( );

    if ( !g_prediction.sync_weapon_input( ) )
    {
        g_cl.m_will_fire = false;
        return;
    }

    g_cl.m_will_fire = g_cl.will_fire_this_tick( );
    g_proj_sim.capture_shot( );
    g_auto_det.capture( );
    g_trajectory.capture( );
    g_proj_camera.capture( );
}

ATLAS_FORCE_INLINE void prepare_medigun_preview( C_WeaponMedigun *medigun )
{
    if ( !g_prediction.m_is_active || medigun != g_cl.m_weapon || !g_prediction.begin_weapon( ) )
    {
        return;
    }

    g_medbot.think( );
    g_holdaim_mgr.on_create_move( );

    if ( !g_prediction.sync_weapon_input( ) )
    {
        g_cl.m_will_fire = false;
        return;
    }

    g_cl.m_will_fire = g_cl.will_fire_this_tick( );
}

ATLAS_FORCE_INLINE void prepare_weapon_busy_frame( C_TFWeaponBase *weapon )
{
    if ( !g_prediction.m_is_active || weapon != g_cl.m_weapon || !g_prediction.begin_weapon( ) )
    {
        return;
    }

    // CBasePlayer chose ItemBusyFrame before entering the weapon. PrimaryAttack cannot execute
    // on this command;
    g_cl.m_will_fire = false;

    g_trajectory.capture( );

    if ( g_ragebot.cancel_reload( ) )
    {
        g_prediction.sync_weapon_input( );
    }
}

void ATLAS_FASTCALL hkWeaponItemPostFrame( C_TFWeaponBase *thisptr )
{
    if ( !g_cl.m_is_running || !g_cl.m_local || !g_cl.m_weapon )
    {
        return g_hooks.m_weapon_item_post_frame.thiscall< void >( thisptr );
    }

    prepare_weapon_preview( thisptr );

    const f32 last_fire{ thisptr->m_flLastFireTime( ) };
    g_hooks.m_weapon_item_post_frame.thiscall< void >( thisptr );

    if ( g_prediction.m_is_active && thisptr == g_cl.m_weapon )
    {
        g_cl.latch_throw( last_fire );
    }

    g_cl.predict_reload_shell( thisptr );
}

